# Blockchain
RPC_URL=https://your-rpc-provider.example/v3/your-project-id
EVENT_TICKETS_ADDRESS=0xYourDeployedEventTicketsContract
ORGANIZER_PRIVATE_KEY=your_private_key_without_0x
PLATFORM_WALLET_ADDRESS=0xYourCustodialTicketWallet
